ENV=prod

# Telegram
BOT_TOKEN=123456:ABC-DEF
WEBHOOK_SECRET=dev-secret
PUBLIC_URL=https://your-public-host

# Redis / Postgres
REDIS_ADDR=127.0.0.1:6379
DATABASE_URL=postgres://user:pass@localhost:5432/imodel?sslmode=disable

# Providers
REPLICATE_API_TOKEN=your_replicate_token
OPENAI_API_KEY=

# S3 (optional)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Feature flags
PREVIEW_FIRST=1

# Admin
ADMIN_PANEL_SECRET=change-me
ADMIN_IDS=123456789
WHITELIST_IDS=
ADMIN_BASIC_USER=
ADMIN_BASIC_PASS=
