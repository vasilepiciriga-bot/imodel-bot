# Пример файла .env – скопируйте этот файл в ".env" и подставьте свои значения.

# Telegram bot
BOT_TOKEN=

# Webhook URL base (без завершающего '/') и секрет для query-параметра
# Пример: WEBHOOK_BASE=https://your-app.up.railway.app
WEBHOOK_BASE=
WEBHOOK_SECRET=secret123

# Replicate
REPLICATE_API_TOKEN=

# OpenAI (можно отключить рефайн переменной DISABLE_GPT_REFINE=1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o

# S3 (Backblaze B2 совместимый)
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Опционально
LANG_DEFAULT=en
FREE_QUOTA=5
ADMIN_IDS=
ADMIN_USERNAMES=@piciriga,@MarkBeth_beauty
GALLERY_CHANNEL_ID=
PUBLISH_GROUP_ID=
AUTO_POST=0
DISABLE_GPT_REFINE=0
ALLOW_NSFW=0
ALLOW_CELEBS=1
METRICS_SECRET=
ADMIN_PANEL_SECRET=
SESSION_GAP_SECONDS=900

# Nudges (re-engagement pushes)
NUDGE_ENABLED=0
NUDGE_INTERVAL_HOURS=24
NUDGE_MIN_GAP_HOURS=24
NUDGE_BATCH_LIMIT=25
NUDGE_DAY_START_HOUR=10
NUDGE_DAY_END_HOUR=20
NUDGE_TZ_DEFAULT=UTC
# Optional per-language TZ overrides
NUDGE_TZ_RU=Europe/Moscow
NUDGE_TZ_RO=Europe/Bucharest
NUDGE_TZ_EN=UTC
NANOBANANA_MODEL=google/nano-banana
ESRGAN_MODEL=nightmareai/real-esrgan
RETOUCH_MODEL=
