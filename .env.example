# Пример файла .env – скопируйте этот файл в ".env" и подставьте свои значения.

# Telegram bot
BOT_TOKEN=

# Webhook URL base (без завершающего '/') и секрет для query-параметра
# Пример: WEBHOOK_BASE=https://your-app.up.railway.app
WEBHOOK_BASE=
WEBHOOK_SECRET=secret123
# Если запускаете вторую копию (воркер/эксперименты) с тем же BOT_TOKEN —
# установите DISABLE_WEBHOOK=1, чтобы не сбить вебхук основной инстанс
DISABLE_WEBHOOK=0

# Replicate
REPLICATE_API_TOKEN=

# Replicate models
# Основной генератор (оставьте дефолт или укажите owner/name:version своей модели)
NANOBANANA_MODEL=google/nano-banana
# Апскейлер x4 (Real-ESRGAN)
ESRGAN_MODEL=nightmareai/real-esrgan
 # InstantID (опционально). Укажите свой slug/версию, если модель доступна вашему токену.
INSTANTID_MODEL=tencentarc/instantid
# Настройки InstantID
INSTANTID_FIRST=1
INSTANTID_TEXT_OK=1
# В Copy Mode использовать стиль как вход в InstantID (вместе с селфи)
INSTANTID_USE_STYLE_IN_COPY=0
# Полностью отключить InstantID
DISABLE_INSTANTID=0

# OpenAI (можно отключить рефайн переменной DISABLE_GPT_REFINE=1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o

# S3 (Backblaze B2 совместимый)
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Опционально
LANG_DEFAULT=en
FREE_QUOTA=3
# Batch generation
BATCH_MAX=5
BATCH_MIN=2
ADMIN_IDS=
ADMIN_USERNAMES=@piciriga,@MarkBeth_beauty
GALLERY_CHANNEL_ID=
PUBLISH_GROUP_ID=
AUTO_POST=0
DISABLE_GPT_REFINE=0
ALLOW_NSFW=0
ALLOW_CELEBS=1
METRICS_SECRET=
ADMIN_PANEL_SECRET=
SESSION_GAP_SECONDS=900

# Nudges (re-engagement pushes)
NUDGE_ENABLED=0
NUDGE_INTERVAL_HOURS=24
NUDGE_MIN_GAP_HOURS=24
NUDGE_BATCH_LIMIT=25
NUDGE_DAY_START_HOUR=10
NUDGE_DAY_END_HOUR=20
NUDGE_TZ_DEFAULT=UTC
# Optional per-language TZ overrides
NUDGE_TZ_RU=Europe/Moscow
NUDGE_TZ_RO=Europe/Bucharest
NUDGE_TZ_EN=UTC
VIDEO_MODEL=stability-ai/stable-video-diffusion
VIDEO_COST=2

# Group auto-posts (promo)
# Disabled by default to avoid accidental posting
GROUP_POSTS_ENABLED=0
# Set to 0 to enable images; 1 = text-only
GROUP_POST_TEXT_ONLY=0
# Language rotation for group posts (comma-separated)
GROUP_POST_LANGS=ru,ro
# Fixed interval in minutes (set >0 to override quiet hours); 0 = random window
GROUP_POST_EVERY_MINUTES=0
# Random window in hours when GROUP_POST_EVERY_MINUTES=0
GROUP_POST_MIN_HOURS=2
GROUP_POST_MAX_HOURS=3
# Quiet hours window (no posts outside start..end) when using random window
GROUP_POST_START_HOUR=8
GROUP_POST_END_HOUR=22
